# Google Gemini API Key for AI categorizations and recommendations
GEMINI_API_KEY="your_api_key_here"

# JWT Secret Key for Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY="your_jwt_secret_key_here"
GEMINI_MODEL=gemini-2.5-flash

# TextBee SMS gateway for budget alerts (https://textbee.dev)
# Get key + register Android device at textbee.dev/dashboard. Never commit real values.
TEXTBEE_API_KEY="your_textbee_api_key_here"
# Optional: force a specific sending device (omit to use default/most-recent device)
TEXTBEE_DEVICE_ID=""
# Mobile number receiving budget SMS, E.164 format (e.g. +919876543210)
BUDGET_SMS_RECIPIENT=""
# Master switch for budget SMS
BUDGET_SMS_ENABLED="true"
# Max SMS per day (TextBee free tier = 50/day; keep well under)
BUDGET_SMS_DAILY_CAP="10"
# true = log only, never hit TextBee (safe testing, spends zero quota)
TEXTBEE_DRY_RUN="false"
